def kt(term, defn): return [Paragraph(f"■ {term}:", s_kt_h), Paragraph(defn, s_kt_b)]
def rule(): return HRFlowable(width="100%", thickness=0.5, color=BDR, spaceBefore=4, spaceAfter=4)
def gksub(t): return [Spacer(1,4), Paragraph(f"■  {t}", s_gk_s), Spacer(1,2)]

def mktbl(headers, rows, cws, alt=ROW1):
    u = uw(); cws = [u*x for x in cws]
    data = [[Paragraph(h, s_th) for h in headers]]
    for row in rows: data.append([Paragraph(str(c), s_td) for c in row])
    ts = TableStyle([
        ("BACKGROUND",(0,0),(-1,0),NAV),("FONTNAME",(0,0),(-1,0),"Helvetica-Bold"),
        ("FONTSIZE",(0,0),(-1,-1),7.8),("ALIGN",(0,0),(-1,-1),"LEFT"),
        ("VALIGN",(0,0),(-1,-1),"MIDDLE"),("ROWBACKGROUNDS",(0,1),(-1,-1),[ROW2,alt]),
        ("GRID",(0,0),(-1,-1),0.35,BDR),("TOPPADDING",(0,0),(-1,-1),3),
        ("BOTTOMPADDING",(0,0),(-1,-1),3),("LEFTPADDING",(0,0),(-1,-1),5),
        ("RIGHTPADDING",(0,0),(-1,-1),4),
    ])
    return Table(data, colWidths=cws, style=ts, repeatRows=1)

def on_page(canvas, doc):
    canvas.saveState()
    canvas.setFillColor(NAV); canvas.rect(0, H-TM+2, W, TM, fill=1, stroke=0)
    canvas.setFillColor(GOLD); canvas.setFont("Helvetica-Bold", 7.5)
    canvas.drawString(LM, H-14, "Weekly Current Affairs  |  13–20 June 2026")
    canvas.setFillColor(HexColor("#B0BEC5")); canvas.setFont("Helvetica", 7)
    canvas.drawRightString(W-RM, H-14, f"Page {doc.page}  |  DailyCA_QuizZ")
    canvas.restoreState()

