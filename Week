        c.drawCentredString(self.W/2, self.height/2-5, self.title)

def sec(num, title, gk=False):
    return [Spacer(1,6), SecBar(num, title, uw(), gk=gk), Spacer(1,5)]
def nh(hl, dt): return [NHBar(hl, dt, uw()), Spacer(1,2)]
