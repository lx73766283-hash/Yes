        c.setFillColor(GOLD); c.setFont("Helvetica-Bold",7); c.drawCentredString(self.W-28,7.5,self.dt)
        c.setFillColor(NAV); c.setFont("Helvetica-Bold",8.5); c.drawString(10,5.5,self.hl)

class PartDiv(Flowable):
    def __init__(self,w,title): Flowable.__init__(self); self.W,self.title=w,title; self.height=36
    def draw(self):
        c=self.canv; c.setFillColor(GKN); c.roundRect(0,0,self.W,self.height,6,fill=1,stroke=0)
